#. Plugin Name of the plugin
#: konform.php
msgid "Konform – EU E-Invoicing for WooCommerce"
msgstr ""

#. Plugin URI of the plugin
#: konform.php
msgid "https://konform.dev/"
msgstr ""

#. Description of the plugin
#: konform.php
msgid "Turns WooCommerce orders into legally valid e-invoices for the seller's country and delivers them through the seller's own e-invoicing provider."
msgstr ""

#. Author of the plugin
#: konform.php
msgid "Cisoft"
msgstr ""

