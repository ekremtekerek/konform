{
  "name": "ekremtekerek/konform",
  "description": "EU e-invoicing for WooCommerce. Converts orders into legally valid e-invoices.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2",
    "ext-dom": "*",
    "freemius/wordpress-sdk": "^2.13",
    "horstoeko/zugferd": "^1.0.132"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "php-stubs/woocommerce-stubs": "^9.0",
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^3.0",
    "brianhenryie/strauss": "^0.22"
  },
  "autoload": {
    "psr-4": {
      "Konform\\": "src/"
    },
    "classmap": [
      "vendor-prefixed/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Konform\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.2.0"
    },
    "process-timeout": 0
  },
  "scripts": {
    "lint": "phpcs --standard=../../phpcs.xml.dist",
    "lint:fix": "phpcbf --standard=../../phpcs.xml.dist",
    "strauss": [
      "@php vendor/bin/strauss",
      "@php ../../bin/post-strauss.php",
      "@composer dump-autoload -o"
    ],
    "test": "phpunit"
  },
  "extra": {
    "strauss": {
      "target_directory": "vendor-prefixed",
      "namespace_prefix": "Konform\\Vendor\\",
      "classmap_prefix": "Konform_",
      "constant_prefix": "KONFORM_",
      "delete_vendor_packages": false,
      "exclude_from_prefix": {
        "packages": [
          "symfony/polyfill-ctype",
          "symfony/polyfill-mbstring",
          "symfony/polyfill-php83",
          "freemius/wordpress-sdk"
        ]
      },
      "packages": [
        "horstoeko/zugferd"
      ]
    }
  }
}
