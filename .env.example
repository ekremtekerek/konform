# Kopyala: cp .env.example .env
WP_PORT=8088
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# bin/setup.sh tarafindan kullanilir
WP_URL=http://localhost:8088
WP_TITLE="Konform Dev"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=dev@example.test

# Magaza ulkesi = regulasyon profili. Bkz. docs/I18N.md
WP_LOCALE=tr_TR
WC_STORE_COUNTRY=FR:*
